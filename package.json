{
  "name": "able-leave-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Leave Management System - Cloudflare Pages + Pages Functions + D1",
  "scripts": {
    "dev": "wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply able-leave-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply able-leave-db --remote",
    "import:sheet": "node scripts/import-sheet.mjs",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
